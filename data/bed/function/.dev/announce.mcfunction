execute if score #bed.mode takis.bed.scan matches 1 if score #bed.current takis.bed.scan matches 1 run tellraw @a [{"selector":"@a[scores={takis.bed.near=1}]","color":"yellow"},{"text":" is close to a bed. Is sleeping much of an ask?","color":"gray"}]
execute if score #bed.mode takis.bed.scan matches 1 if score #bed.current takis.bed.scan matches 2.. run tellraw @a [{"selector":"@a[scores={takis.bed.near=1}]","separator":{"text":" and ","color":"gray"},"color":"yellow"},{"text":" are close to a bed. Is sleeping much of an ask?","color":"gray"}]
execute if score #bed.mode takis.bed.scan matches 2 if score #bed.current takis.bed.scan matches 1 run tellraw @a [{"selector":"@a[scores={takis.bed.near=2}]","color":"yellow"},{"text":" has a bed in their inventory. Is sleeping much of an ask?","color":"gray"}]
execute if score #bed.mode takis.bed.scan matches 2 if score #bed.current takis.bed.scan matches 2.. run tellraw @a [{"selector":"@a[scores={takis.bed.near=2}]","separator":{"text":" and ","color":"gray"},"color":"yellow"},{"text":" have beds in their inventories. Is sleeping much of an ask?","color":"gray"}]
